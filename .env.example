[TEMPLATE]
# Forge configuration
# Copy to .env (or .env.local) and fill in — never commit real keys.

# ── Market data ──────────────────────────────────────────────────────
# Twelve Data API key (free at https://twelvedata.com/pricing).
# Enables real OHLC for Spot Gold (XAU/USD).
# Without it, metals show an explicit not-configured unavailable state —
# no proxy instrument is ever substituted.
VITE_TWELVEDATA_API_KEY=

# ── Oracle AI (server-side only — NEVER exposed to the browser) ─────
# Read from the server environment (Vercel Production etc.). The frontend
# never sees it; /api/oracle/models only reports whether it is configured.
# Gemini is the ONLY external AI provider. The Local engine is a separate
# explicit deterministic option that needs no key.
GEMINI_API_KEY=
